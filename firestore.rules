rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return autenticado() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.ativo != false;
    }

    match /produtos/{produtoId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    match /blog/{postId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    match /configuracoes/{docId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    match /historico/{registroId} {
      allow read, write: if ehAdmin();
    }

    match /admins/{uid} {
      allow get: if autenticado() && request.auth.uid == uid;
      allow list: if ehAdmin();
      allow create, update, delete: if false;
    }

    match /estoque_produtos/{produtoId} {
      allow read, write: if ehAdmin();
    }

    match /estoque_movimentacoes/{movimentacaoId} {
      allow read, write: if ehAdmin();
    }

    match /pedidos/{id} { allow read, write: if ehAdmin(); }
    match /clientes/{id} { allow read, write: if ehAdmin(); }
    match /campanhas/{id} { allow read, write: if ehAdmin(); }
    match /backups/{id} { allow read, write: if ehAdmin(); }

    // Preferências sincronizadas de clientes autenticados (favoritos e carrinho).
    match /usuarios/{uid} {
      allow read, write: if autenticado() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
